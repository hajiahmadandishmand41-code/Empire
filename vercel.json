{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "node scripts/vercel-build.mjs",
  "regions": ["fra1"],
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/release-expired-reservations",
      "schedule": "5 0 * * *"
    }
  ]
}
