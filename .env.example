# ---------------------------------------------------------------------------
# Empire Shop — environment template
# Copy to `.env.local` for local development, or set these in the Vercel
# Project Settings → Environment Variables for Production.
# NEVER commit real values: `.env*` (except this file) is git-ignored.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# PostgreSQL connection string. On Vercel use a pooled connection URL.
DATABASE_URL="postgresql://empire_user:empire_pass@localhost:5432/empire_shop"
# Direct (non-pooled) connection — REQUIRED on Vercel/Neon/Supabase.
# `npm run db:deploy` and the production build prefer these for migrations,
# because pooled (PgBouncer) endpoints break advisory locks and DDL.
DATABASE_URL_UNPOOLED=""
POSTGRES_URL_NON_POOLING=""
# Set SKIP_DB_MIGRATE=1 to build without applying migrations.
# Signing key for the HMAC-SHA256 session cookie (min 32 random chars).
AUTH_SECRET=""
# Public site origin. Required in production (emails, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional: alternate public URLs --------------------------------------
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_BASE_URL=""
NEXT_PUBLIC_API_BASE_URL=""

# --- Optional: auth -------------------------------------------------------
# Explicit demo mode only. Never set in production.
APP_MODE=""
SESSION_SECRET=""
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Dev-only mock auth. Must stay unset/false in production.
ALLOW_MOCK_AUTH=""
DEMO_PASSWORD=""

# --- Required: role provisioning (npm run db:provision) -------------------
# Used by scripts/provision-roles.ts to create/update the real Admin and
# Seller accounts. Never hardcode credentials — always set these via
# environment variables (Vercel Project Settings → Environment Variables).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
SELLER_EMAIL=""
SELLER_PASSWORD=""
SELLER_NAME=""

# --- Optional: payments (Atoma Pay) ---------------------------------------
ATOMA_PAY_BASE_URL=""
ATOMA_PAY_CREATE_PATH="/v1/payments"
ATOMA_PAY_STATUS_PATH="/v1/payments/:id"
ATOMA_PAY_PUBLIC_BASE_URL=""
ATOMA_PAY_MERCHANT_ID=""
ATOMA_PAY_API_KEY=""
ATOMA_PAY_WEBHOOK_SECRET=""

# --- Optional: email (SMTP) -----------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Optional: SMS --------------------------------------------------------
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# --- Optional: web push ---------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""

# --- Optional: rate limiting / cache (Upstash Redis) ----------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
API_RATE_LIMIT="60"
API_RATE_WINDOW_MS="60000"

# --- Optional: observability / security -----------------------------------
LOG_LEVEL="info"
METRICS_TOKEN=""
CSP_REPORT_ONLY=""
CSP_CONNECT_EXTRA=""

# Persistent object storage (required for production uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=empire-shop

# Google OAuth (optional; enable the Google button when configured)
# Create a Web OAuth client in Google Cloud Console and add:
# https://YOUR_DOMAIN/api/auth/google/callback

# ATOMA Pay (required for production online payments)
# ATOMA's public site documents merchant registration, but the public site does not publish
# the web API endpoint contract. Get the official API base URL/paths and credentials from
# ATOMA merchant onboarding, then set the values below. Never guess or commit secrets.
