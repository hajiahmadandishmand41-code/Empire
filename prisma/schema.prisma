// Empire Shop — Prisma schema (Phase 12.1 + Phase 12.2 Auth + Phase 1: Payments + Phase 3: Shipping + Phase 6: Shopping UX)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enums omitted unchanged

enum OrderStatus { pending confirmed processing shipped delivered cancelled }
enum PaymentMethod { cod bank_transfer whatsapp atoma_pay }
enum PaymentStatus { pending paid failed refunded cancelled }
enum Role { customer seller admin }
enum SellerStatus { none pending approved rejected }
enum ShippingKind { standard express cod }
enum VerificationTokenType { email_verification phone_otp password_reset otp_login two_factor_setup }

model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  fullName String
  passwordHash String
  role Role @default(customer)
  isActive Boolean @default(true)
  sellerStatus SellerStatus @default(none)
  sellerShopName String?
  sellerBio String?
  commissionRate Decimal @default(10) @db.Decimal(5, 2)
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  sellerLogoUrl String?
  sellerBannerUrl String?
  sellerWhatsapp String?
  sellerContactEmail String?
  sellerContactPhone String?
  sellerAddress String?
  sellerCity String?
  sellerCountry String?
  sellerBankAccountNumber String?
  sellerBankAccountName String?
  sellerBankName String?
  sellerAtomaPay String?
  sellerInstagram String?
  sellerTelegram String?
  sellerFacebook String?
  sellerLinkedin String?
  sellerWebsite String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses Address[]
  orders Order[]
  carts Cart[]
  products Product[] @relation("SellerProducts")
  wishlist WishlistItem[]
  reviews Review[]
  wallet SellerWallet?
  payouts Payout[]
  sellerApplications SellerApplication[] @relation("SellerApplicationsByUser")
  reviewedApplications SellerApplication[] @relation("SellerApplicationsReviewedBy")
  verificationTokens VerificationToken[]
  notifications SellerNotification[]
  @@index([sellerStatus])
}

model VerificationToken {
  id String @id @default(cuid())
  userId String
  token String @unique
  type VerificationTokenType
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
}

model Category {
  id String @id @default(cuid())
  key String @unique
  name String
  slug String @unique
  products Product[]
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  shortDescription String
  description String?
  price Decimal @db.Decimal(18, 2)
  currency String @default("USD")
  badge String?
  region String
  inStock Boolean @default(true)
  isActive Boolean @default(true)
  stockQuantity Int @default(0)
  compareAtPrice Decimal? @db.Decimal(18, 2)
  featuresJson Json?
  imagesJson Json?
  salesCount Int @default(0)
  viewCount Int @default(0)
  whatsappNumber String?
  videoUrl String?
  isTraditional Boolean @default(false)
  weightKg Decimal? @db.Decimal(10, 3)
  dimensionsJson Json?
  tagsJson Json?
  attributesJson Json?
  primaryImageIndex Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  sellerId String?
  seller User? @relation("SellerProducts", fields: [sellerId], references: [id])
  orderItems OrderItem[]
  cartItems CartItem[]
  wishlistBy WishlistItem[]
  reviews Review[]
  @@index([categoryId])
  @@index([sellerId])
  @@index([sellerId, isActive, salesCount, createdAt])
  @@index([salesCount])
  @@index([viewCount])
  @@index([price])
  @@index([inStock])
  @@index([isActive])
  @@index([isActive, createdAt])
}

// Remaining models unchanged.
