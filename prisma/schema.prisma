// Empire Shop — Prisma schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Product import idempotency record. Keeps retries from creating duplicate batches.
model ProductImportBatch {
  id             String   @id @default(cuid())
  sellerId       String
  idempotencyKey String
  createdCount   Int      @default(0)
  createdAt      DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, idempotencyKey])
  @@index([sellerId, createdAt])
}

