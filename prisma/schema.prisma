// Empire Shop — Prisma schema (Phase 12.1 + Phase 12.2 Auth + Phase 1: Payments + Phase 3: Shipping + Phase 6: Shopping UX)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  bank_transfer
  whatsapp
  atoma_pay
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum Role {
  customer
  seller
  admin
}

enum SellerStatus {
  none
  pending
  approved
  rejected
}

enum ShippingKind {
  standard
  express
  cod
}

// Phase 12 — Auth enhancements
enum VerificationTokenType {
  email_verification
  phone_otp
  password_reset
  otp_login
  /// Legacy value retained for non-destructive compatibility with existing databases.
  two_factor_setup
}

model User {
  id             String       @id @default(cuid())
  email          String?      @unique
  phone          String?      @unique
  fullName       String
  passwordHash   String
  role           Role         @default(customer)
  isActive       Boolean      @default(true)
  sellerStatus   SellerStatus @default(none)
  sellerShopName String?
  sellerBio      String?
  /// Percentage that Empire Shop retains from every sale for this seller.
  /// Only meaningful when role = seller. Range 0..100.
  commissionRate Decimal      @default(10) @db.Decimal(5, 2)

  // Phase 12 — Auth fields
  emailVerified    Boolean @default(false)
  phoneVerified    Boolean @default(false)
  /// Legacy 2FA columns retained to avoid destructive schema changes. Feature is removed from application code.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  // Phase 12+ — Seller store settings
  sellerLogoUrl      String?
  sellerBannerUrl    String?
  sellerWhatsapp     String?
  sellerContactEmail String?
  sellerContactPhone String?
  sellerAddress      String?
  sellerCity         String?
  sellerCountry      String?

  // Payment account info — used as default for payout requests
  sellerBankAccountNumber String?
  sellerBankAccountName   String?
  sellerBankName          String?
  sellerAtomaPay          String? // ATOMA Pay account ID or phone

  // Social media & web presence
  sellerInstagram String?
  sellerTelegram  String?
  sellerFacebook  String?
  sellerLinkedin  String?
  sellerWebsite   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses            Address[]
  orders               Order[]
  carts                Cart[]
  products             Product[]            @relation("SellerProducts")
  wishlist             WishlistItem[]
  reviews              Review[]
  wallet               SellerWallet?
  payouts              Payout[]
  sellerApplications   SellerApplication[]  @relation("SellerApplicationsByUser")
  reviewedApplications SellerApplication[]  @relation("SellerApplicationsReviewedBy")
  verificationTokens   VerificationToken[]
  notifications        SellerNotification[]

  @@index([sellerStatus])
}

/// Verification tokens for email, phone OTP, password reset, OTP login, and legacy 2FA setup
model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
}

model Category {
  id       String    @id @default(cuid())
  key      String    @unique
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  shortDescription  String
  description       String?
  price             Decimal  @db.Decimal(18, 2)
  currency          String   @default("USD")
  badge             String?
  region            String
  inStock           Boolean  @default(true)
  isActive          Boolean  @default(true)
  stockQuantity     Int      @default(0)
  compareAtPrice    Decimal?  @db.Decimal(18, 2)
  featuresJson      Json?
  imagesJson        Json?
  salesCount        Int      @default(0)
  viewCount         Int      @default(0)
  whatsappNumber    String?
  videoUrl          String?
  isTraditional     Boolean  @default(false)
  // Extended product fields
  weightKg          Decimal? @db.Decimal(10, 3)
  dimensionsJson    Json? // JSON: {"length":0,"width":0,"height":0} in cm
  tagsJson          Json? // JSON: string[]
  attributesJson    Json? // JSON: {key:string,value:string}[]
  primaryImageIndex Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  sellerId String?
  seller   User?   @relation("SellerProducts", fields: [sellerId], references: [id])

  orderItems OrderItem[]
  cartItems  CartItem[]
  wishlistBy WishlistItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([salesCount])
  @@index([viewCount])
  @@index([price])
  @@index([inStock])
  @@index([isActive])
}

model Address {
  id          String   @id @default(cuid())
  userId      String?
  label       String?
  fullName    String
  phone       String
  province    String
  district    String
  city        String?
  addressLine String
  postalCode  String?
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
}

model ShippingMethod {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  kind        ShippingKind @default(standard)
  cost        Decimal      @default(0) @db.Decimal(18, 2)
  currency    String       @default("USD")
  etaDays     Int?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders Order[]
}

model Order {
  id            String        @id @default(cuid())
  reference     String        @unique
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod @default(cod)
  paymentStatus PaymentStatus @default(pending)

  subtotal  Decimal @db.Decimal(18, 2)
  shipping  Decimal @default(0) @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)
  currency  String @default("USD")
  itemCount Int

  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  // Immutable checkout snapshot; historical orders must not change when an address is edited.
  shippingFullName   String?
  shippingPhone      String?
  shippingProvince   String?
  shippingDistrict   String?
  shippingCity       String?
  shippingAddressLine String?
  shippingPostalCode String?
  shippingNotes      String?

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])

  items        OrderItem[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([addressId])
  @@index([shippingMethodId])
  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  slug      String
  name      String
  price     Decimal @db.Decimal(18, 2)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String
  reference     String        @unique
  provider      String
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  amount        Decimal @db.Decimal(18, 2)
  currency      String        @default("USD")
  providerTxnId String?
  providerRaw   Json?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Prevents the same provider payment from being ingested twice
  // (e.g. duplicate webhook deliveries creating parallel Transactions).
  // Postgres treats NULLs as distinct, so pending rows without a
  // providerTxnId are unaffected.
  @@unique([provider, providerTxnId], name: "provider_providerTxnId_unique")
  @@unique([orderId, method, status], name: "order_method_status_unique")
  @@index([orderId])
  @@index([status])
  @@index([providerTxnId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Phase 6 — Improved shopping experience
// -----------------------------------------------------------------------------

/// A customer's favorite product. Uniqueness on (userId, productId).
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// A customer review + rating. One review per user per product.
/// `rating` is 1..5 (also enforced by a DB CHECK constraint).
model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

// -----------------------------------------------------------------------------
// Phase 7 — Seller finance
// -----------------------------------------------------------------------------

enum PayoutStatus {
  pending
  approved
  paid
  rejected
}

enum PayoutMethod {
  bank_transfer
  cash
  whatsapp
  atoma_pay
}

enum WalletTxType {
  sale
  commission
  payout
  payout_reversal
  refund
  adjustment
}

/// One wallet per seller. Balance is the authoritative running total,
/// always kept in sync with the sum of all wallet transactions via
/// a single Prisma $transaction on the server.
model SellerWallet {
  id           String   @id @default(cuid())
  sellerId     String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  totalEarned  Decimal  @default(0) @db.Decimal(18, 2)
  totalPaidOut Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller       User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([sellerId])
}

/// Immutable ledger entry against a seller's wallet.
/// `amount` is signed: positive = credit to seller, negative = debit.
model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  sellerId    String
  type        WalletTxType
  amount      Decimal @db.Decimal(18, 2)
  currency    String       @default("USD")
  orderId     String?
  orderItemId String?
  payoutId    String?
  /// Idempotency key so re-running the "credit sellers for order" job
  /// never double-credits. Format: `sale:<orderItemId>` / `payout:<payoutId>`.
  dedupeKey   String?      @unique
  description String?
  createdAt   DateTime     @default(now())

  wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payout Payout?      @relation(fields: [payoutId], references: [id])

  @@index([walletId])
  @@index([sellerId])
  @@index([type])
  @@index([orderId])
  @@index([payoutId])
  @@index([createdAt])
}

/// A seller-initiated withdrawal request that admin approves and pays out.
model Payout {
  id          String       @id @default(cuid())
  reference   String       @unique
  sellerId    String
  amount      Decimal @db.Decimal(18, 2)
  currency    String       @default("USD")
  method      PayoutMethod @default(bank_transfer)
  status      PayoutStatus @default(pending)
  /// Free-form account information provided by the seller
  /// (bank name + account number, WhatsApp number, etc.).
  accountInfo String
  sellerNote  String?
  adminNote   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  seller       User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Phase 10.3 — Admin audit log
// -----------------------------------------------------------------------------

/// Append-only trail of sensitive admin actions (order status changes,
/// payout decisions, user role / seller-status changes, etc.). Rows are
/// written by `src/lib/audit/log.ts` and are never mutated or deleted
/// from application code. Store snapshots in `beforeJson` / `afterJson`
/// as compact JSON strings — schema-agnostic so future entity types
/// (products, categories, shipping methods) can reuse the same table.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorRole    String
  action       String
  entityType   String
  entityId     String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Phase 13 — Seller Notifications
// -----------------------------------------------------------------------------

model SellerNotification {
  id        String   @id @default(cuid())
  sellerId  String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error, order
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([isRead])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Phase 11 — Seller Applications
// -----------------------------------------------------------------------------

enum SellerApplicationStatus {
  pending
  approved
  rejected
}

/// A customer's application to become a seller. Admins review these
/// from the admin panel; approving one flips the User to role=seller
/// (and sellerStatus=approved) and copies shop info onto the User row.
/// A user can only have one non-rejected application open at a time.
model SellerApplication {
  id              String                  @id @default(cuid())
  userId          String
  shopName        String
  ownerName       String
  phone           String
  address         String
  description     String?
  logoUrl         String?
  status          SellerApplicationStatus @default(pending)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user       User  @relation("SellerApplicationsByUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SellerApplicationsReviewedBy", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
