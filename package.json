{
  "name": "eshop",
  "version": "0.14.0",
  "private": true,
  "description": "Eshop — Afghan general e-commerce storefront. Next.js 16 + TypeScript + Tailwind + shadcn/ui + next-intl.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "prisma generate && next build && npm run standalone:prepare",
    "start": "node scripts/validate-production-env.mjs && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "standalone:prepare": "node scripts/prepare-standalone.mjs",
    "build:standalone": "npm run build",
    "start:standalone": "npm run standalone:prepare && node scripts/validate-production-env.mjs && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint src scripts prisma --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "architecture:check": "node scripts/architecture-contract.mjs",
    "remediation:check": "node scripts/remediation-contract.mjs",
    "release-check": "node scripts/release-check.mjs",
    "release-gate": "node scripts/release-gate.mjs",
    "audit:prod": "npm audit --omit=dev",
    "production:check": "STRICT_PRODUCTION_CHECK=true node scripts/production-check.mjs",
    "host:check": "node scripts/host-readiness.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "stress:test": "node scripts/stress-test.mjs",
    "db:benchmark": "tsx scripts/db-benchmark.ts",
    "monitor:production": "node scripts/monitor-production.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:provision-roles": "tsx scripts/provision-roles.ts",
    "db:studio": "prisma studio"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.8",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.1",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.0.4",
    "react": "19.2.8",
    "react-day-picker": "^9.7.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "5.13.1",
    "vaul": "^1.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/node": "24.12.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=24.0.0 <25.0.0", "npm": ">=10.0.0" },
  "overrides": { "braces": ">=3.0.3", "brace-expansion": "1.1.18", "micromatch": ">=4.0.8", "semver": ">=7.5.4" }
}
